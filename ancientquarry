-- Resolve the reset teleport target. Priority:
--   1. _G.__AncientQuarryResetPos (set by the loader)
--   2. shared.__AncientQuarryResetPos
--   3. getgenv().__AncientQuarryResetPos (if the executor provides it)
--   4. default 6000, 403, -60000
local function resolveResetPos()
    local candidates = {}

    if _G and _G.__AncientQuarryResetPos then
        table.insert(candidates, _G.__AncientQuarryResetPos)
    end
    if typeof(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and env and env.__AncientQuarryResetPos then
            table.insert(candidates, env.__AncientQuarryResetPos)
        end
    end
    if _G and _G.shared and _G.shared.__AncientQuarryResetPos then
        table.insert(candidates, _G.shared.__AncientQuarryResetPos)
    end

    for _, candidate in ipairs(candidates) do
        if typeof(candidate) == "Vector3" then
            return candidate
        end
    end

    return Vector3.new(6000, 403, -60000)
end

